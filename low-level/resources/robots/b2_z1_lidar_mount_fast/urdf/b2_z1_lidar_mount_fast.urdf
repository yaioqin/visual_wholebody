<?xml version="1.0"?>
<robot name="b2_z1_lidar_mount_fast_description">
  <material name="dark">
    <color rgba="0.12 0.14 0.16 1.0" />
  </material>
  <material name="silver">
    <color rgba="0.70 0.70 0.68 1.0" />
  </material>
  <material name="green">
    <color rgba="0.1 0.75 0.2 1.0" />
  </material>

  <!-- Match b1z1's retained body tree when collapse_fixed_joints=true:
       base holds the collapsed Z1 mount; floating_base keeps the torso as a
       separate body. base_link is B2's counterpart of B1's trunk, so fixed
       body IDs address the same parts while B2 configs keep their link name.
       Verified Isaac Gym body IDs: 0 base, 1 torso, 2-17 legs in FL/FR/RL/RR
       order (hip/thigh/calf/foot), 18-23 link01-link06, 24 ee_gripper_link,
       25 gripperMover. DOF IDs: 0-11 legs in FL/FR/RL/RR order, 12-17 arm,
       18 movable gripper. Keep the fixed-joint boundaries below intact. -->
  <link name="base">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <box size="0.001 0.001 0.001" />
      </geometry>
    </visual>
  </link>
  <joint name="floating_base" type="fixed" dont_collapse="true">
    <origin rpy="0 0 0" xyz="0 0 0" />
    <parent link="base" />
    <child link="base_link" />
  </joint>
  <link name="base_link">
    <!-- B2 mass and inertia values are uniformly scaled by
         0.7158342000097067 so base_link plus all four legs total 60 kg. -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="../assets/base_link.obj" scale="1 1 1" />
      </geometry>
      <material name="silver" />
    </visual>
    <!-- Fast-training collision: the lidar remains in the base_link visual
         mesh, while physics uses one torso box for the combined base body. -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.50 0.28 0.15" />
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0212868 0.0045819 0.0106169" rpy="0 0 0" />
      <mass value="29.2365298973164" />
      <inertia ixx="0.253728402363532" ixy="0.00262063607786234" ixz="-0.0871209263724916" iyy="1.19148460171438" iyz="0.000350344791086891" izz="1.236354881104" />
    </inertial>
  </link>

  <!-- Leg declarations follow b1z1: FR, FL, RR, RL. -->
  <link name="FR_hip">
    <visual><geometry><mesh filename="../assets/FR_hip.obj" scale="1 1 1" /></geometry><material name="silver" /></visual>
    <inertial><origin xyz="-0.00829923 0.00998502 0.000235465" rpy="0 0 0" /><mass value="1.81063102550455" /><inertia ixx="0.00199633051458505" ixy="-0.000134031220774577" ixz="-4.40953867205979e-06" iyy="0.00346348932999017" iyz="5.02143374622809e-06" izz="0.0026530226361568" /></inertial>
  </link>
  <joint name="FR_hip_joint" type="revolute">
    <origin xyz="0.3285 -0.072 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="FR_hip" />
    <axis xyz="1 0 0" />
    <dynamics damping="0.1" friction="0.1" />
    <limit effort="200" lower="-0.87" upper="0.87" velocity="23.0" />
  </joint>

  <link name="FR_thigh">
    <visual><geometry><mesh filename="../assets/FR_thigh.obj" scale="1 1 1" /></geometry><material name="silver" /></visual>
    <visual><geometry><mesh filename="../assets/FR_thigh_protect.obj" scale="1 1 1" /></geometry><material name="dark" /></visual>
    <collision><origin xyz="-0.03 0 -0.20" rpy="0 1.5700 0" /><geometry><box size="0.25 0.028 0.04" /></geometry></collision>
    <inertial><origin xyz="-0.00418663 0.0366068 -0.0432737" rpy="0 0 0" /><mass value="5.33683029475237" /><inertia ixx="0.0603021373663878" ixy="-0.000814427619212284" ixz="-0.00329642636955666" iyy="0.0592874662967363" iyz="-0.0084849744015304" izz="0.00968654527104895" /></inertial>
