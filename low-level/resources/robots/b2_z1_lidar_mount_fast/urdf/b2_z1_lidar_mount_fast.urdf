  <!-- As in b1z1's base_static_joint, merge link00 into base rather than
       retaining an extra rigid body. base and base_link have identical frames,
       so the B2 mounting transform and all downstream Z1 poses are preserved. -->
  <joint name="z1_mount_joint" type="fixed">
    <origin xyz="0.34218 0 0.23851" rpy="0 0 0" />
    <parent link="base" />
    <child link="link00" />
  </joint>
  <link name="link00">
